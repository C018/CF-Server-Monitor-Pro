    curl -s -6 -m 3 https://cloudflare.com/cdn-cgi/trace 2>/dev/null | grep -q "ip=" && IPV6="1" || IPV6="0"
  fi
  
  if [ \\$((LOOP_COUNT % 6)) -eq 0 ]; then
    # 国内三网: NodeQuality 省级测速域名池（31 省 × 电信/联通/移动），并发 ICMP 取最优(最小)延迟作为该网代表值
