PING_NODE_CM="${cfg.pingCm}"
PING_NODE_GG="${cfg.pingGg}"
PING_NODE_CF="${cfg.pingCf}"

while true; do
  if [ \\$((LOOP_COUNT % 60)) -eq 0 ]; then
