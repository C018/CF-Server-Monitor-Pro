            ping_cu = "$PING_CU"
            ping_cm = "$PING_CM"
            ping_bd = "$PING_BD"
            ping_gg = "$PING_GG"
            ping_cf = "$PING_CF"
            ping_ct_m = "$PING_M_CT"
            ping_cu_m = "$PING_M_CU"
            ping_cm_m = "$PING_M_CM"
            ping_bd_m = "$PING_M_BD"
            ping_gg_m = "$PING_M_GG"
