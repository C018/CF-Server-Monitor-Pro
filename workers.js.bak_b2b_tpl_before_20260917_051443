               // 旧版本「全部」档（值 0）迁移为近 72 小时，避免出现无高亮的空白档位
               try { if (parseInt(localStorage.getItem(HIST_RANGE_KEY), 10) === 0) localStorage.setItem(HIST_RANGE_KEY, String(HIST_RANGE_FULL)); } catch (err) {}
